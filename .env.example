# Authera environment (CLAUDE_IMPLEMENTATION_SPEC.md §19). Copy to .env for local work.
# Placeholders only — never commit real secrets. Blank values are treated as unset.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://authera:authera@localhost:5432/authera
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# At least 32 characters. Production refuses this placeholder.
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Demo controls (defaults: on locally, off in production). Reset secret protects /api/demo/*.
DEMO_MODE=true
DEMO_RESET_SECRET=replace-with-a-demo-reset-secret
DEMO_CLOCK_ENABLED=false

# mock | stripe — the complete demo runs in mock mode without external services.
# stripe = real PaymentIntents in Stripe test mode (needs STRIPE_SECRET_KEY=sk_test_…).
PAYMENT_MODE=mock
# scripted | openai — scripted is the deterministic offline agent.
OPENAI_MODE=scripted
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: live flight market via the Duffel Flights API (a duffel_test_… token works).
# When set, /api/flights also searches Duffel and stores its offers under the "Duffel Marketplace"
# merchant; the winner is revalidated before checkout. Unset = seeded markets only.
DUFFEL_ACCESS_TOKEN=

# Optional: live goods market — a public Shopify storefront (real catalog and prices, no key).
# When set, /api/products searches it and stores results under the "Allbirds (Shopify)" merchant.
SHOPIFY_STOREFRONT_URL=

# Required only when PAYMENT_MODE=stripe (test-mode key; live keys are refused).
STRIPE_SECRET_KEY=
# Optional: signing secret for POST /webhooks/stripe (whsec_…). Unset = webhooks rejected.
STRIPE_WEBHOOK_SECRET=

# Ed25519 private JWKs (JSON). Seeded/generated in later phases; keep out of the repository.
TRUSTED_SURFACE_PRIVATE_JWK=
MERCHANT_PRIVATE_JWK=
AGENT_PRIVATE_JWK=

# Passkeys (P1).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Optional: absolute path of the compiled SPA served by the API (defaults to apps/web/dist).
WEB_DIST_DIR=
