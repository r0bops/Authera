{
  "name": "@agentcerta/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL persistence for AgentCerta: client, schema, migrations, repositories, atomic transitions",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "demo:reset": "tsx src/demo-reset.ts"
  },
  "dependencies": {
    "@agentcerta/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
