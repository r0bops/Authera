{
  "name": "@agentcerta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentCerta HTTP application: Hono on Node.js 24, serves the API and the compiled SPA",
  "exports": {
    "./app": "./src/app.ts",
    "./config": "./src/config.ts",
    "./logger": "./src/logger.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentcerta/contracts": "workspace:*",
    "@agentcerta/db": "workspace:*",
    "@agentcerta/domain": "workspace:*",
    "@hono/node-server": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "jose": "6.2.10",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@agentcerta/test-support": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
